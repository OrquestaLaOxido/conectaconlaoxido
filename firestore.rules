rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /eventos/{eventoId}/mensajes/{mensajeId} {

      // El público puede CREAR mensajes (desde publico.html),
      // pero solo con estado "pendiente" y campos limitados.
      allow create: if request.resource.data.estado == 'pendiente'
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() < 300
                    && request.resource.data.instagram is string
                    && request.resource.data.instagram.size() < 60;

      // Solo el operador (con sesión iniciada) puede leer la bandeja,
      // aprobar, rechazar o borrar mensajes.
      allow read, update, delete: if request.auth != null;
    }

    match /eventos/{eventoId}/en_vivo/{docId} {

      // El overlay (sin sesión) necesita LEER lo que está en pantalla.
      allow read: if true;

      // Solo el operador puede publicar contenido en el overlay.
      allow write: if request.auth != null;
    }
  }
}
